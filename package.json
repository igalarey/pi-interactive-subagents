{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Async process-backed subagents for pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/amosblomqvist/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts test/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "test:live:pilot": "node test/live-pilot.mjs",
    "test:smoke": "node --test test/pi85-compat.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "typebox": "1.3.7"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-server": "0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
